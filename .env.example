FR_LISTEN=127.0.0.1:8080
# Extra host names the UI answers to (comma-separated), e.g. the Caddy site name.
FR_ALLOWED_HOSTS=feeds.lan.example
FR_DATA_DIR=/var/lib/feedreader
FR_POLL_INTERVAL=6h
# Default check interval of YouTube channel and playlist feeds (a channel's
# "Videos only" and "Shorts only" feeds included).
FR_POLL_INTERVAL_YOUTUBE=1h
FR_FETCH_WORKERS=4
FR_FETCH_MAX_BODY=10485760
# User-Agent sent to feed servers. Leave unset: the default is
# feedreader/<version> (+<repo-url>), built from the binary's version.
# Set it only to override that on purpose.
# FR_USER_AGENT=
FR_LOG_LEVEL=info
# Time zone of digest ingestion times and of the times shown, e.g.
# Europe/Rome; unset = the system's. TZ is read from the process environment
# (this file, as the systemd unit's EnvironmentFile), not from -config.
# TZ=Europe/Rome
# Kill switch for YouTube video transcripts (unofficial and best-effort: slow
# on purpose, one video at a time; see README). true lets the switch at the
# bottom of the UI's sidebar turn them on (they start off there); false means
# no transcript is ever requested.
FR_TRANSCRIPTS=true
# When a YouTube channel's feed (or its videos-only / Shorts-only list) answers
# 404 or 5xx without Retry-After, read its latest videos from YouTube's web API instead
# (unofficial; see README). false only retries the feed.
FR_YOUTUBE_FALLBACK=true
